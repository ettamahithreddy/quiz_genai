# QuizGen AI - Configuration
# Server
PORT=5000
FLASK_ENV=development
DEBUG=True

# MongoDB Configuration
# For local or Atlas: mongodb+srv://<username>:<password>@cluster.mongodb.net/quiz_generator?retryWrites=true&w=majority
MONGO_URI=your_mongodb_atlas_connection_string
DB_NAME=quiz_generator

# JWT Secret for authentication
JWT_SECRET_KEY=quizgen_super_secret_jwt_key_2026_change_in_production

# AI / LLM Configuration (Google Gemini / OpenAI / AI Provider)
GEMINI_API_KEY=
AI_API_KEY=

# Upload Configuration
MAX_CONTENT_LENGTH=20971520 # 20MB in bytes
UPLOAD_FOLDER=uploads
